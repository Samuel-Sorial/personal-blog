---
import BaseLayout from './BaseLayout.astro';
import type { CollectionEntry } from 'astro:content';
interface Props { post: CollectionEntry<'blog'>; }
const { post } = Astro.props;
const { title, description, publishDate, updatedDate, tags, heroImage, canonicalUrl } = post.data;
const formatted = publishDate.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
const canonical = canonicalUrl ?? new URL(`/${post.id}/`, Astro.site).href;
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: publishDate.toISOString(),
  ...(updatedDate && { dateModified: updatedDate.toISOString() }),
  mainEntityOfPage: canonical,
  url: canonical,
  author: { '@type': 'Person', '@id': 'https://samuelsorial.com/about/#samuel-sorial', name: 'Samuel Sorial', url: 'https://samuelsorial.com/about/' },
  publisher: { '@type': 'Person', '@id': 'https://samuelsorial.com/about/#samuel-sorial', name: 'Samuel Sorial' },
  keywords: tags.join(', '),
  ...(heroImage && { image: new URL(heroImage, Astro.site).href }),
};
---
<BaseLayout title={title} description={description} canonical={canonical} image={heroImage} type="article" structuredData={structuredData} publishDate={publishDate} updatedDate={updatedDate} tags={tags}>
  <article class="article shell article-shell">
    <header class="article-header">
      <h1>{title}</h1>
      <p class="article-meta"><time datetime={publishDate.toISOString()}>{formatted}</time>{updatedDate && <> · Updated <time datetime={updatedDate.toISOString()}>{updatedDate.toLocaleDateString('en-US')}</time></>}</p>
      {tags.length > 0 && <ul class="tags" aria-label="Tags">{tags.map((tag) => <li><a href={`/tags/${encodeURIComponent(tag.toLowerCase())}`}>{tag}</a></li>)}</ul>}
    </header>
    {heroImage && <img class="hero-image" src={heroImage} alt="" />}
    <div class="prose"><slot /></div>
  </article>
</BaseLayout>
