---
interface Props { title?: string; description: string; canonical?: string; image?: string; type?: 'website' | 'article'; structuredData?: Record<string, unknown> | Record<string, unknown>[]; noindex?: boolean; publishDate?: Date; updatedDate?: Date; tags?: string[]; }
const { title, description, canonical = Astro.url.href, image, type = 'website', structuredData, noindex = false, publishDate, updatedDate, tags = [] } = Astro.props;
const siteTitle = "Samuel Sorial's Blog";
const fullTitle = title ? `${title} | ${siteTitle}` : siteTitle;
const imageUrl = image ? new URL(image, Astro.site) : undefined;
---
<title>{fullTitle}</title>
<meta name="description" content={description} />
{noindex && <meta name="robots" content="noindex,follow" />}
<link rel="canonical" href={canonical} />
<meta property="og:type" content={type} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:site_name" content={siteTitle} />
{type === 'article' && publishDate && <meta property="article:published_time" content={publishDate.toISOString()} />}
{type === 'article' && updatedDate && <meta property="article:modified_time" content={updatedDate.toISOString()} />}
{type === 'article' && <meta property="article:author" content="Samuel Sorial" />}
{type === 'article' && tags.map((tag) => <meta property="article:tag" content={tag} />)}
{imageUrl && <meta property="og:image" content={imageUrl} />}
<meta name="twitter:card" content={imageUrl ? 'summary_large_image' : 'summary'} />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
{imageUrl && <meta name="twitter:image" content={imageUrl} />}
<link rel="alternate" type="application/rss+xml" title={siteTitle} href="/rss.xml" />
{structuredData && <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />}
