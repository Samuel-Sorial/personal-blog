---
const pathname = Astro.url.pathname;
const links = [{ href: '/', label: 'Home' }, { href: '/archive', label: 'Archive' }, { href: '/about', label: 'About' }];
---
<header class="site-header">
  <div class="shell header-inner">
    <a class="brand" href="/">Samuel Sorial's Blog</a>
    <nav aria-label="Primary navigation">
      {links.map(({ href, label }) => <a href={href} aria-current={pathname === href ? 'page' : undefined}>{label}</a>)}
      <a href="/rss.xml" aria-label="RSS feed">RSS</a>
    </nav>
  </div>
</header>
