---
import type { CollectionEntry } from 'astro:content';
interface Props { post: CollectionEntry<'blog'>; }
const { post } = Astro.props;
const date = post.data.publishDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
---
<article class="post-card">
  <div>
    <h2><a href={`/${post.id}`}>{post.data.title}</a></h2>
    <p>{post.data.description}</p>
    <div class="meta"><time datetime={post.data.publishDate.toISOString()}>{date}</time></div>
  </div>
</article>
